---
import printScript from "../report-print.js?url";
---
<div class="report-print-action">
  <button type="button" data-report-pdf hidden><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H3V9h18v9h-3M6 14h12v7H6ZM17 12h1" /></svg>Exporter en PDF</button>
  <small>Exemple fictif. Impression du navigateur : choisir « Enregistrer au format PDF ».</small>
</div>
<script src={printScript} defer></script>
<style>
  .report-print-action{display:grid;gap:8px;max-width:320px}
  button{display:flex;align-items:center;justify-content:center;gap:10px;background:#2b4557;color:white;padding:12px 16px;border:1px solid #536f82;border-radius:4px 14px 4px 4px;font:600 15px/1.5 system-ui,sans-serif;cursor:pointer}
  button[hidden]{display:none}
  button:hover{background:#193449;color:white}
  button:focus-visible{outline:3px solid #496c86;outline-offset:3px}
  small{font:14px/1.5 system-ui,sans-serif}
</style>
