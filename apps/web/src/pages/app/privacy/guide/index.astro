---
import SiteHeader from "../../../../features/privacy/components/SiteHeader.astro";
import favicon from "../../../../features/privacy/assets/rgpdesk-symbol.svg?url";
import { Content, getHeadings } from "../../../../../../../docs/rgpd/GUIDE-UTILISATEUR.md";
import "../../../../features/privacy/privacy.css";
import "../../../../features/privacy/atelier.css";
import "../../../../features/privacy/iconography.css";
import InterviewLibrary from "../../../../features/privacy/components/InterviewLibrary.svelte";
import ReviewMethods from "../../../../features/privacy/components/ReviewMethods.svelte";
import Pictogram from "../../../../features/privacy/components/Pictogram.svelte";
const chapters = getHeadings().filter((heading) => heading.depth === 2);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Le guide RGPDESK : créer un registre, décrire un traitement, importer un CSV, suivre les actions, partager un dossier et restaurer une sauvegarde chiffrée." />
    <title>RGPDESK | Guide utilisateur : du premier registre à la restauration</title>
  </head>
  <body class="rgpdesk">
    <a class="skip-link" href="#main">Aller au contenu</a>
    <SiteHeader current="guide" />
    <main id="main" class="guide-main">
      <header class="guide-hero intro"><p class="eyebrow"><span class="eyebrow-line"></span>Le mode d’emploi, du début à la suite</p><h1>Menez l’entretien.<br /><em>Construisez l’analyse.</em></h1><p>Préparez votre premier entretien, décrivez une activité et transformez les réponses manquantes en prochaines actions. Des exemples et des repères visuels vous accompagnent tout au long de la mission.</p><div class="guide-cover-art" aria-hidden="true"><Pictogram kind="book" /><span>LE MANUEL</span><strong>Du fait<br />au choix.</strong></div><div class="guide-meta"><span>Édition du 24 septembre 2026</span><span>Pour les DPO et référents RGPD</span><span>À consulter pendant vos entretiens</span></div></header>
      <div class="guide-layout">
        <aside class="guide-sidebar"><nav aria-label="Sommaire du guide"><p class="eyebrow">Dans ce guide</p><a class="guide-business-link" href="#atelier-dpo">L’atelier : analyse, contrats et flux</a><a class="guide-business-link" href="#trames-metier">Les trames métier</a><ol>{chapters.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text.replace(/^\d+\. /, "")}</a></li>)}</ol></nav><a class="button" href="/app/privacy/">Ouvrir mon registre</a><p class="help">Enregistrez votre travail avant de consulter l’aide : le coffre se verrouille après une minute en arrière-plan.</p></aside>
        <article class="guide-content"><ReviewMethods /><InterviewLibrary /><Content /><a class="guide-top" href="#main">Revenir au début du guide ↑</a></article>
      </div>
    </main>
    <footer class="privacy-footer"><p>RGPDESK · Registre, suivi documentaire et partage examiné.</p><p><a href="/app/privacy/confidentialite/">Confidentialité et limites</a> · <a href="/release.json">Version servie</a> · <a href="/LICENSE.txt">AGPL-3.0-only</a> · Dérivé de BLACKPROOF-AGPL.</p></footer>
  </body>
</html>
