---
import SiteHeader from "../../../features/privacy/components/SiteHeader.astro";
import favicon from "../../../features/privacy/assets/rgpdesk-symbol.svg?url";
import PrivacyApp from "../../../features/privacy/components/PrivacyApp.svelte";
import "../../../features/privacy/privacy.css";
import "../../../features/privacy/atelier.css";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Décrivez vos traitements de données personnelles, tenez votre registre RGPD, suivez vos actions et préparez un dossier à partager. Coffre local, sans compte." />
    <title>RGPDESK | Votre registre RGPD, de la fiche au dossier partagé</title>
  </head>
  <body class="rgpdesk">
    <a class="skip-link" href="#main">Aller au contenu</a>
    <SiteHeader current="workspace" />
    <main id="main"><PrivacyApp client:load /><noscript>JavaScript est nécessaire pour le chiffrement et le stockage local. Aucune donnée ne sera envoyée à un serveur.</noscript></main>
    <footer class="privacy-footer"><p>RGPDESK · Registre, suivi documentaire et partage examiné</p><p>Dérivé de BLACKPROOF-AGPL. <a href="/LICENSE.txt">Licence AGPL-3.0-only</a> · <a href="/app/privacy/guide/" target="_blank" rel="noopener noreferrer">Guide d’utilisation</a> · <a href="/app/privacy/confidentialite/" target="_blank" rel="noopener noreferrer">Confidentialité et limites</a> · <a href="https://github.com/l0gfr/RGPDESK" rel="noreferrer noopener" target="_blank">Dépôt RGPDESK</a> · <a href="https://github.com/l0gfr/BLACKPROOF-AGPL" rel="noreferrer noopener" target="_blank">Source du socle</a></p><p>Un espace pour tenir votre registre, préparer vos échanges et suivre vos décisions.</p></footer>
  </body>
</html>
